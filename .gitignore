# Whitelist: ignore everything at the top level, then re-include only what
# belongs on the public site. Keeps the textbook PDFs (copyrighted, ~200 MB)
# and generated .docx/.pdf/.zip out of the repository.
/*
!/site/
!/build/
!/.github/
!/.gitignore
!/*.md
# The session-builder agent and the /build-session command travel with the
# repository; everything else under .claude/ (local settings, launch config) stays local.
!/.claude/
/.claude/*
!/.claude/agents/
!/.claude/skills/
